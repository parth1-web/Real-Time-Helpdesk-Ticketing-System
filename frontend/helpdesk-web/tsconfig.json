{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext", "skipLibCheck": true, "strict": true,
    "moduleResolution": "bundler", "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true, "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx", "esModuleInterop": true, "resolveJsonModule": true,
    "isolatedModules": true, "noEmit": true
  },
  "include": ["src"]
}
