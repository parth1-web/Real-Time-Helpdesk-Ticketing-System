# .env example — copy to .env, never commit secrets
ConnectionStrings__Default=Host=localhost;Port=5432;Database=helpdesk;Username=postgres;Password=postgres
Jwt__Key=dev-super-secret-key-change-me-32chars!!
Jwt__Issuer=Helpdesk
Jwt__Audience=HelpdeskClients
Redis__Connection=localhost:6379
VITE_API_URL=http://localhost:5000
# Production: set via Render/Railway/Azure env vars, Neon/Supabase PG, Upstash Redis, Vercel frontend URL
