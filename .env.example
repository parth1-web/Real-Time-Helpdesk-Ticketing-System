# Copy to .env or configure these through your hosting provider.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=helpdesk;Username=postgres;Password=replace-me
Jwt__Key=replace-with-a-random-secret-at-least-32-characters
Jwt__Issuer=Helpdesk
Jwt__Audience=HelpdeskClients
Redis__Connection=localhost:6379
VITE_API_URL=http://localhost:5000
# Production: use Render/Railway/Azure environment variables, managed PostgreSQL, and managed Redis.
